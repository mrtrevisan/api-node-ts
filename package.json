{
  "name": "myurl",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "yarn -s generate && node esbuild.config.js",
    "typecheck": "yarn -s generate && tsc --noEmit",
    "lint": "yarn -s generate && eslint .",
    "format": "prettier --write src prisma.config.ts esbuild.config.js eslint.config.js",
    "serve": "node --enable-source-maps dist/main.js",
    "migrate": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "start:local": "yarn build && node --enable-source-maps --env-file=etc/config/local.env dist/main.js",
    "migrate:local": "node --env-file=etc/config/local.env node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file=etc/config/local.env node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
