{
  "name": "api-node-ts",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "serve": "node --enable-source-maps dist/main.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "start:local": "yarn build && node --enable-source-maps --env-file=etc/config/local.env dist/main.js",
    "migrate:local": "yarn build && node --enable-source-maps --env-file=etc/config/local.env dist/migrate.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
